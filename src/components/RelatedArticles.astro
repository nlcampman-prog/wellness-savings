---
const { articles = [] } = Astro.props;
if (!articles.length) return;
---
<section class="related-articles">
  <h2 class="related-heading">You May Also Like</h2>
  <div class="related-grid">
    {articles.map((a: any) => (
      <a href={`/articles/${a.slug}/`} class="related-card">
        <div class="related-image-wrapper">
          {a.featuredImage ? (
            <img src={a.featuredImage} alt="" class="related-image" loading="lazy" width="320" height="180" onerror="this.style.display='none'" />
          ) : null}
          <div class="related-image-fallback">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20c-6 0-9-8-9-8s3-8 9-8 9 8 9 8-3 8-9 8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
        </div>
        <div class="related-card-body">
          <span class="related-card-title">{a.title}</span>
          {a.displayDate && <time class="related-card-date" datetime={a.rawDate || ''}>{a.displayDate}</time>}
        </div>
      </a>
    ))}
  </div>
</section>
