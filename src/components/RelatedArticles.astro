---
const { articles = [] } = Astro.props;
if (!articles.length) return;
---
<section class="related-articles">
  <h2 class="related-heading">You May Also Like</h2>
  <div class="related-grid">
    {articles.map((a: any) => (
      <a href={`/articles/${a.slug}/`} class="related-card">
        <div class="related-image-wrapper">
          {a.featuredImage ? (
            <img src={a.featuredImage} alt={a.title} class="related-image" loading="lazy" width="320" height="180" />
          ) : (
            <div class="related-image-fallback">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
          )}
        </div>
        <div class="related-card-body">
          <span class="related-card-title">{a.title}</span>
          {a.displayDate && <time class="related-card-date" datetime={a.rawDate || ''}>{a.displayDate}</time>}
        </div>
      </a>
    ))}
  </div>
</section>
