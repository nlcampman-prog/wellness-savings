---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getMomModePosts } from '../lib/wordpress';
import { resolveCardImage } from '../lib/images';

const articles = Object.entries(import.meta.glob('../content/articles/*.mdx', { eager: true }))
  .map(([path, mod]: [string, any]) => {
    const slug = path.split('/').pop()?.replace('.mdx', '') || '';
    return {
      ...mod.frontmatter,
      slug,
      image: resolveCardImage(slug, mod.frontmatter?.featuredImage),
    };
  });
const allArticles = articles.sort((a, b) =>
  new Date(b.pubDate || b.date || 0).getTime() - new Date(a.pubDate || a.date || 0).getTime()
);
const featuredArticles = allArticles.filter((a) => a.image).slice(0, 3);
const featuredSlugs = new Set(featuredArticles.map((a) => a.slug));
const latestArticles = allArticles.filter((a) => !featuredSlugs.has(a.slug)).slice(0, 9);

const categoryCounts = new Map<string, number>();
articles.forEach((a) => {
  if (a.category) categoryCounts.set(a.category, (categoryCounts.get(a.category) || 0) + 1);
});
const topCategories = Array.from(categoryCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
const momModePosts = await getMomModePosts(3);
---

<BaseLayout
  title="Wellness Savings"
  description="Save on premium supplements, organic coffee, natural skincare, and wellness products. Daily deals and exclusive discount codes."
  type="website"
>
  <section class="hero">
    <div class="container-narrow">
      <p class="hero-kicker">Mom of five · Honest reviews · Real codes</p>
      <h1>Honest reviews and the codes that actually work</h1>
      <p>No-hype guides for supplements, coffee, skincare, and family gear, plus verified discount codes.</p>
      <div class="hero-actions">
        <a class="aff-btn" href="/categories/">Read reviews &amp; guides</a>
        <a class="btn-secondary" href="/coupons/">Browse coupon codes</a>
      </div>
      <a class="hero-byline" href="/about/">
        <img src="/images/nickie-iced-coffee.jpg" alt="Nichole" width="48" height="48" />
        <span>Nichole, mom of five — every code is one she’d use at home</span>
      </a>
    </div>
  </section>

  <div class="trust-bar">
    <div class="container trust-row">
      <div><strong>Exclusive codes</strong><span>Nichole’s partner discounts, updated regularly</span></div>
      <div><strong>Mom-tested picks</strong><span>A household of seven is a ruthless focus group</span></div>
      <div><strong>Always disclosed</strong><span>Affiliate links, never fake “must-buy” hype</span></div>
    </div>
  </div>

  <div class="container">
    <section class="category-strip">
      <div class="section-heading">
        <h2>Shop by category</h2>
        <a href="/categories/">All categories</a>
      </div>
      <div class="chip-row">
        {topCategories.map(([name, count]) => (
          <a class="chip" href={`/categories/${name.toLowerCase().replace(/\s+/g, '-')}/`}>
            {name} <em>{count}</em>
          </a>
        ))}
      </div>
    </section>

    {featuredArticles.length > 0 && (
      <section>
        <div class="section-heading">
          <h2>Featured deals</h2>
        </div>
        <div class="card-grid">
          {featuredArticles.map((article: any) => (
            <ArticleCard title={article.title} description={article.metaDescription || article.description} url={`/articles/${article.slug}/`} category={article.category} date={article.pubDate || article.date} image={article.image} />
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="section-heading">
        <h2>Latest deals &amp; reviews</h2>
        <a href="/categories/">Browse the archive</a>
      </div>
      <div class="card-grid">
        {latestArticles.map((article: any) => (
          <ArticleCard title={article.title} description={article.metaDescription || article.description} url={`/articles/${article.slug}/`} category={article.category} date={article.pubDate || article.date} image={article.image} />
        ))}
      </div>
    </section>

    {momModePosts.length > 0 && (
      <section>
        <div class="section-heading">
          <h2>From Mom Mode 24/7</h2>
          <a href="/mom-mode/">Fashion, beauty &amp; mom life</a>
        </div>
        <div class="card-grid">
          {momModePosts.map((post) => (
            <ArticleCard
              title={post.title}
              description={post.excerpt}
              url={post.url}
              category={post.category}
              categoryHref="/mom-mode/"
              date={post.date}
              moreLabel="Read on Mom Mode"
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
