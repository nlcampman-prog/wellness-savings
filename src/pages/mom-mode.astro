---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getMomModePosts, MOM_MODE_SITE } from '../lib/wordpress';

const posts = await getMomModePosts(18);
---

<BaseLayout
  title="Mom Mode 24/7 — Fashion, Beauty & Mom Life"
  description="Fashion, beauty, and everyday mom life from Nichole at Mom Mode 24/7, plus the wellness stories behind Wellness Savings."
>
  <div class="container">
    <div class="category-header">
      <p class="card-category" style="margin-bottom: 0.75rem;">Also by Nichole</p>
      <h1>Mom Mode 24/7</h1>
      <p>
        Fashion, beauty, and everyday mom life from Nichole — the same voice behind these reviews, on her lifestyle blog.
      </p>
      <p>
        <a href={MOM_MODE_SITE} target="_blank" rel="noopener noreferrer">Visit mommode247.com</a>
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="card-grid">
        {posts.map((post) => (
          <ArticleCard
            title={post.title}
            description={post.excerpt}
            url={post.url}
            category={post.category}
            categoryHref="/mom-mode/"
            date={post.date}
            moreLabel="Read on Mom Mode"
          />
        ))}
      </div>
    ) : (
      <p>
        Latest posts will appear here after the next successful fetch from{' '}
        <a href={MOM_MODE_SITE} target="_blank" rel="noopener noreferrer">Mom Mode 24/7</a>.
      </p>
    )}
  </div>
</BaseLayout>
