---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonical,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  tags = [],
} = Astro.props as Props;

const siteTitle = 'Wellness Savings';
const fullTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
const siteUrl = 'https://wellnesssavings.org';
const pageUrl = canonical || `${siteUrl}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Enhanced JSON-LD: Organization (always) + Article/BreadcrumbList (articles) + WebSite (non-articles)
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: siteTitle,
      url: siteUrl,
      logo: `${siteUrl}/logo.svg`,
      description: 'Save on premium supplements, organic coffee, natural skincare, and wellness products. Daily deals and exclusive discount codes.',
      founder: {
        '@type': 'Person',
        name: 'Nichole',
        description: 'Mom of 5 (including twins), MS, CCC-SLP, former speech-language pathologist with 10+ years pediatric experience, wellness and nutrition enthusiast.',
        url: `${siteUrl}/authors/nichole/`,
      },
    },
  ],
};

const articleSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@graph': [
    ...baseSchema['@graph'],
    {
      '@type': 'Article',
      headline: title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      dateModified: publishedTime,
      author: {
        '@type': 'Person',
        name: 'Nichole',
        url: `${siteUrl}/authors/nichole/`,
      },
      publisher: {
        '@type': 'Organization',
        name: siteTitle,
        logo: { '@type': 'ImageObject', url: `${siteUrl}/logo.svg` },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: title },
      ],
    },
  ],
} : {
  '@context': 'https://schema.org',
  '@graph': [
    ...baseSchema['@graph'],
    {
      '@type': 'WebSite',
      name: siteTitle,
      url: siteUrl,
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/search?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};

const jsonLd = articleSchema;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={pageUrl} />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {tags.map(tag => <meta property="article:tag" content={tag} />)}
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <title>{fullTitle}</title>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="alternate" type="application/rss+xml" title={`${siteTitle} — Deals & Discount Codes`} href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6524727111653038" crossorigin="anonymous"></script>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-logo">
        <img src="/logo.svg" alt="Wellness Savings" width="200" height="50" />
      </a>
      <nav class="site-nav">
                  <a href="/">Home</a>
                  <a href="/categories/fitness/">Fitness</a>
                  <a href="/categories/family/">Family</a>
                  <a href="/coupons/">Coupons</a>
        <a href="/categories/">Categories</a>
        <a href="/coupons/">Coupons</a>
                  <a href="/about/">About</a>
                  <a href="/contact/">Contact</a>
                  <a href="https://buy.stripe.com/3cIbJ18CK6dp7vKduWbsc02" class="buy-btn" target="_blank" rel="noopener">🌿 Wellness Guide $7</a>
                </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-text">
        &copy; {new Date().getFullYear()} Wellness Savings. All rights reserved.
      </div>
      <div class="footer-links">
                  <a href="/about/">About</a>
                  <a href="/contact/">Contact</a>
                  <a href="/coupons/">Coupons</a>
        <a href="/categories/">Categories</a>
        <a href="/coupons/">Coupons</a>
                  <a href="/privacy/">Privacy Policy</a>
                  <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
                  <a href="https://buy.stripe.com/3cIbJ18CK6dp7vKduWbsc02">🌿 Wellness Guide $7</a>
                </div>
    </div>
  </footer>
</body>
</html>